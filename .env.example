# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b

# Email Service Configuration
# Options: "mock", "smtp", "brevo"
EMAIL_PROVIDER=smtp

# SMTP Configuration (e.g. Gmail)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Brevo (Sendinblue) Configuration (Optional)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=SentinelGate Security

# Lakera Security Intelligence (Optional)
LAKERA_API_KEY=your_lakera_api_key_here
LAKERA_ENABLED=false
LAKERA_MOCK_MODE=none

# Security Subsystem Switches
SECURITY_SEMANTIC=0
SECURITY_SCOPE_LLM=0
USE_MOCK_LLM=0
